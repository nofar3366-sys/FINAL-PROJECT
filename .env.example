# Copy this file to .env and fill in values locally.
# Never commit a real .env file.

SECRET_KEY=change-me-in-production

# Supabase PostgreSQL connection string (required for production / Vercel).
# If your password contains %, encode each % as %25.
# Example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.XXXX.supabase.co:5432/postgres
DATABASE_URL=

GROQ_API_KEY=
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Fitness Studio <onboarding@resend.dev>
CLOUDINARY_URL=
CLOUD_SERVICE_ENABLED=false
