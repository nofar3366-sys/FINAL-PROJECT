# Copy this file to .env and fill in values locally.
# Never commit a real .env file.

SECRET_KEY=change-me-in-production

# --- Supabase Transaction Pooler (preferred for Vercel) ---
# Dashboard: Project Settings → Database → Connect → Connection string
# Mode: Transaction | Port: 6543
#
# Option A: paste the full URI (encode % in passwords as %25)
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
#
# Option B: let the app build it from parts
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_REGION=ap-northeast-1
DATABASE_URL=

# Vercel always uses SQLite (no Postgres probe) so bad Supabase DNS cannot
# kill cold starts. Locally, set FORCE_SQLITE=1 to skip Postgres entirely.
# FORCE_SQLITE=1

GROQ_API_KEY=
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Fitness Studio <onboarding@resend.dev>
