# Copy this file to .env and fill in values locally.
# Never commit a real .env file.

SECRET_KEY=change-me-in-production

# --- Supabase Transaction Pooler (preferred for Vercel) ---
# Dashboard: Project Settings → Database → Connect → Connection string
# Mode: Transaction | Port: 6543
#
# Option A: paste the full URI (encode special password chars: @->%40 /->%2F #->%23)
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: let the app build it from parts
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_REGION=eu-west-2
# Some projects resolve on aws-1 instead of aws-0:
# SUPABASE_POOLER_HOST=aws-1-eu-west-2.pooler.supabase.com
DATABASE_URL=

# Local escape hatch if Supabase is down:
# FORCE_SQLITE=1
# Vercel ALWAYS uses SQLite (serverless cold starts). Keep DATABASE_URL for
# local/Supabase demos only — do not rely on Postgres inside Vercel functions.

GROQ_API_KEY=
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Fitness Studio <onboarding@resend.dev>
